+        // A member changed its device name (Radmin's CChangeAlias, operation
+        // 52 action 10): 0x132d carries its RID and the new name.
+        for r in entries.iter().filter(|r| r.tag == 0x132d) {
+            let f = records(r.value)?;
+            let rid = int64(field(&f, 0x020001e1)?)?;
+            let name = display_text(field(&f, 0x03000304)?)?;
+            if let Some(peer) = self.peers.get_mut(&rid) {
+                peer.name = name;
+            }
+        }
         for r in entries.iter().filter(|r| r.tag == 0x1323) {
             self.read_network(r.value)?;
         }
diff --git a/tests/network_management.rs b/tests/network_management.rs
index 35e3daf..69e17dc 100644
--- a/tests/network_management.rs
+++ b/tests/network_management.rs
@@ -637,3 +637,87 @@ fn delete_is_correlated_and_only_removes_the_target_network() {
         [OTHER.into()].into_iter().collect()
     );
 }
+
+#[test]
+fn change_alias_uses_operation_52_action_10_and_peers_apply_0x132d() {
+    // Request: the device name alone, like Radmin's CChangeAlias.
+    let (mut operation, bytes) = NetworkOperation::start(
+        NetworkRequest::Alias {
+            name: "New device name".into(),
+        },
+        101,
+        7,
+    )
+    .unwrap();
+    let expected = [
+        u32v(CLIENT_OP, 52),
+        tlv(
+            0x1319,
+            &[
+                u32v(0x0100030c, 10),
+                u64v(0x02000340, 101),
+                u32v(0x0100034a, 7),
+                textv(0x03000304, "New device name").unwrap(),
+            ]
+            .concat(),
+        ),
+    ]
+    .concat();
+    assert_eq!(bytes, expected);
+    assert!(NetworkOperation::start(NetworkRequest::Alias { name: " ".into() }, 101, 7).is_err());
+
+    // Server acknowledgement completes it; a refusal is reported.
+    let mut membership = Membership::default();
+    let done = operation
+        .handle(&response(10, 101, Some(7), &[]), &mut membership)
+        .unwrap();
+    assert!(!done.complete.unwrap().error);
+    let (mut refused, _) =
+        NetworkOperation::start(NetworkRequest::Alias { name: "Other".into() }, 102, 8).unwrap();
+    let done = refused
+        .handle(&response(10, 102, Some(8), &u32v(0x010001d2, 5)), &mut membership)
+        .unwrap();
+    assert!(done.complete.unwrap().error);
+
+    // Live update other members receive: op 41, 0x131f { 0x132d { RID, name } }.
+    membership.peers.insert(
+        MEMBER,
+        Peer {
+            rid: MEMBER,
+            name: "Old name".into(),
+            vip: Ipv4Addr::new(26, 1, 2, 3),
+            server: None,
+            state: 1,
+            network_ids: [GUID.to_string()].into(),
+        },
+    );
+    let change = packet(
+        41,
+        0x131f,
+        &[
+            u32v(0x010003a6, 1),
+            tlv(
+                0x132d,
+                &[
+                    u64v(0x020001e1, MEMBER),
+                    textv(0x03000304, "Renamed member").unwrap(),
+                ]
+                .concat(),
+            ),
+        ]
+        .concat(),
+    );
+    membership.changes(&change).unwrap();
+    assert_eq!(membership.peers[&MEMBER].name, "Renamed member");
+    // Unknown members are ignored rather than invented.
+    let unknown = packet(
+        41,
+        0x131f,
+        &tlv(
+            0x132d,
+            &[u64v(0x020001e1, 7), textv(0x03000304, "Nobody").unwrap()].concat(),
+        ),
+    );
+    membership.changes(&unknown).unwrap();
+    assert!(!membership.peers.contains_key(&7));
+}
